@AbapCatalog.viewEnhancementCategory: [ #NONE ]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Relatório Sintético - Total (sem setor)'
@Metadata.ignorePropagatedAnnotations: true

define view entity ZSD_I_SINTVLRPRVHEADTOTCDS
  with parameters
    p_DataInicio : dats,
    p_DataFim    : dats

  as select from ZSD_I_SINTVLRPRVHEADERCDS as H
{
  key H.CodigoFornecedor,
  key H.ContratoCondicao,
  key H.Compensado,

      max(H.CompensadoText)  as CompensadoText,
      max(H.NomeFornecedor)  as NomeFornecedor,
      max(H.NomeResponsavel) as NomeResponsavel,

      @Semantics.amount.currencyCode: 'waers'
      sum(H.dmbtr)           as dmbtr,

      H.waers
}
where ( H.Compensado <> 'X' )
   or ( H.Compensado = 'X'
        and ( ($parameters.p_DataInicio = '00000000' and $parameters.p_DataFim = '00000000')
              or (H.DataCompensacao between $parameters.p_DataInicio and $parameters.p_DataFim) ) )
group by
  H.CodigoFornecedor,
  H.ContratoCondicao,
  H.Compensado,
  H.waers
